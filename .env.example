# Runtime: development | test | production.
# En production se exigen PostgreSQL, JWT_SECRET_KEY de 32+ caracteres,
# GEMINI_API_KEY y EXPOSE_PASSWORD_RESET_CODE=false.
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
DATABASE_URL=postgresql+asyncpg://avendia:change_me@localhost:5432/avendia
# Esquema donde vive la app. Obligatorio en producción (scripts/prepare_production.py);
# vacío en local significa "public".
DATABASE_SCHEMA=
DATABASE_SSL_REQUIRED=false
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origen público del frontend desplegado. Vacío para no añadir ninguno.
PRODUCTION_FRONTEND_ORIGIN=https://avendia-web.vercel.app
# Limitador de intentos en login, recuperación de contraseña y generación IA.
RATE_LIMIT_ENABLED=true
# Solo en desarrollo sin SMTP: devuelve el código de recuperación en la respuesta.
EXPOSE_PASSWORD_RESET_CODE=true
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# Cuenta de administrador inicial. La crean scripts/prepare_production.py
# (producción) y scripts/bootstrap_local.py (local) si no existe ninguna.
ADMIN_EMAIL=admin@avendia.com
ADMIN_PASSWORD=Avendia2026!
ADMIN_FULL_NAME=Administrador Avendia

# Required in production for password recovery emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Avendia
SMTP_USE_TLS=true

# AI providers belong only to the API process
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45

# Imágenes automáticas para presentaciones. En modo auto se usa Google si las
# dos credenciales existen y Wikimedia Commons como respaldo reutilizable.
PRESENTATION_IMAGE_PROVIDER=auto
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
PRESENTATION_IMAGE_TIMEOUT_SECONDS=55
BLOB_READ_WRITE_TOKEN=

# Frontend
VITE_API_URL=http://127.0.0.1:8001/api/v1

# Vista exacta de Word (páginas reales). Producción usa LibreOffice (LIBREOFFICE_BIN opcional).
# En Windows sin LibreOffice se usa el Word instalado fuera de producción; pon false para desactivarlo.
PREVIEW_WORD_FALLBACK=true
