# Runtime
ENVIRONMENT=development

# API
DATABASE_URL=postgresql+asyncpg://avendia:change_me@localhost:5432/avendia
DATABASE_SCHEMA=
DATABASE_SSL_REQUIRED=false
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# Required in production for password recovery emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Avendia
SMTP_USE_TLS=true

# AI providers belong only to the API process
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45

# Imágenes automáticas para presentaciones. En modo auto se usa Google si las
# dos credenciales existen y Wikimedia Commons como respaldo reutilizable.
PRESENTATION_IMAGE_PROVIDER=auto
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
PRESENTATION_IMAGE_TIMEOUT_SECONDS=55
BLOB_READ_WRITE_TOKEN=

# Frontend
VITE_API_URL=http://127.0.0.1:8001/api/v1
